---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import EditableText from '../components/EditableText.astro';
import Badge from '../components/Badge.astro';
import { content } from '../config/site';

const { badgeText, heading, body } = content.schedule;
const embedCode = content.schedule?.embedCode ?? '';
---

<Layout title="Schedule a Call | Crestline Landscapes">
  <PageHero imageId="schedule-hero" title="Schedule a Call" />
  <Breadcrumb label="Schedule" />

  <div class="schedule-section" style="position:relative;padding:100px 40px;" data-dev-hover-zone={import.meta.env.DEV ? true : undefined}>
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <Badge editKey="schedule.badgeText" value={badgeText} tone="dark" style="align-items:center;" />
      <EditableText
        editKey="schedule.heading"
        value={heading}
        as="h1"
        style="font-family:var(--font-heading);font-weight:700;font-size:var(--fsH2, 36px);text-transform:var(--heading-case);margin:0 0 14px;color:var(--color-ink);"
      />
      <EditableText
        editKey="schedule.body"
        value={body}
        as="p"
        multiline
        style="font-size:var(--fsBody, 17px);line-height:1.7;color:oklch(0.4 0.02 255);max-width:560px;margin:0 auto 48px;"
      />
    </div>

    <div style="max-width:var(--container-width);margin:0 auto;">
      {embedCode ? (
        <div set:html={embedCode} />
      ) : (
        <div class="schedule-placeholder" style="border:1px dashed oklch(0.85 0.006 255);border-radius:var(--radius);padding:60px 40px;text-align:center;color:oklch(0.5 0.02 255);font-size:14px;">
          Paste your calendar booking embed code (e.g. Calendly, HubSpot Meetings) using the control below — visible on hover in edit mode.
        </div>
      )}
    </div>

    {import.meta.env.DEV && (
      <div
        class="dev-embed-control"
        data-embed-key="schedule.embedCode"
        data-embed-value={embedCode}
        style="position:absolute;bottom:12px;right:12px;z-index:9999;pointer-events:auto;"
      ></div>
    )}
  </div>
</Layout>

<style>
  @media (max-width: 640px) {
    .schedule-section {
      padding: 56px 20px !important;
    }

    .schedule-placeholder {
      padding: 40px 20px !important;
    }
  }
</style>
