---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { areas } from '../../data/areas';
import { withBase } from '../../lib/base';
---

<Layout title="Areas We Cover | Pine Landscapes" description="Areas we currently cover for Pine Landscapes services.">
  <PageHero imageId="contact-hero" title="Areas" />

  <Breadcrumb label="Areas" />

  <div class="areas-page" style="position:relative;">
    <div style="max-width:var(--container-width);margin:0 auto;display:flex;gap:64px;flex-wrap:wrap;align-items:flex-start;">
      <div style="flex:1 1 760px;">
        <h1 style="font-family:var(--font-heading);font-weight:700;font-size:var(--fsH2, 36px);text-transform:var(--heading-case);margin:0 0 16px;color:var(--color-ink);">
          Areas We Cover
        </h1>
        <p style="font-size:var(--fsBody, 17px);line-height:1.7;color:oklch(0.4 0.02 255);margin:0 0 32px;">
          Select an area below to view the local service page.
        </p>
        <div class="areas-list">
        {areas.map((area) => (
          <a class="areas-link-card" href={withBase(`/${area.servicePath}/${area.slug}`)}>
            <span class="areas-link-title">{area.area}</span>
            <span class="areas-link-meta">{area.serviceLabel} in {area.area}</span>
          </a>
        ))}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .areas-page {
    padding: 100px 40px;
  }

  .areas-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .areas-link-card {
    display: block;
    background: #fff;
    border: 1px solid oklch(0.9 0.01 255);
    border-radius: var(--radius);
    padding: 26px;
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(15, 20, 35, 0.06);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .areas-link-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-accent) 35%, white);
    box-shadow: 0 22px 46px rgba(15, 20, 35, 0.1);
  }

  .areas-link-title {
    display: block;
    margin-bottom: 8px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
  }

  .areas-link-meta {
    color: oklch(0.45 0.02 255);
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .areas-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .areas-page {
      padding: 56px 20px;
    }
  }
</style>
