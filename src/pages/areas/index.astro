---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { areas } from '../../data/areas';
import { withBase } from '../../lib/base';
---

<Layout title="Areas We Cover | Pine Landscapes" description="Areas we currently cover for Pine Landscapes services.">
  <section class="areas-hero">
    <div class="areas-shell">
      <p class="areas-kicker">Hidden Area Pages</p>
      <h1 class="areas-title">Areas</h1>
      <p class="areas-copy">Choose an area below to view the local service page.</p>
    </div>
  </section>

  <Breadcrumb label="Areas" />

  <section class="areas-list-section">
    <div class="areas-shell">
      <div class="areas-list">
        {areas.map((area) => (
          <a class="areas-link-card" href={withBase(`/areas/${area.slug}`)}>
            <span class="areas-link-title">{area.area}</span>
            <span class="areas-link-meta">{area.serviceLabel} in {area.area}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .areas-shell {
    max-width: var(--container-width);
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .areas-hero {
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    padding: 84px 0 72px;
    color: #fff;
  }

  .areas-kicker {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .areas-title {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-size: 46px;
    font-weight: 700;
    color: #fff;
  }

  .areas-copy {
    margin: 0;
    max-width: 640px;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.88);
  }

  .areas-list-section {
    padding: 72px 0 88px;
  }

  .areas-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .areas-link-card {
    display: block;
    background: #fff;
    border: 1px solid oklch(0.9 0.01 255);
    border-radius: var(--radius);
    padding: 26px;
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(15, 20, 35, 0.06);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .areas-link-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-accent) 35%, white);
    box-shadow: 0 22px 46px rgba(15, 20, 35, 0.1);
  }

  .areas-link-title {
    display: block;
    margin-bottom: 8px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
  }

  .areas-link-meta {
    color: oklch(0.45 0.02 255);
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .areas-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .areas-shell {
      padding-left: 20px;
      padding-right: 20px;
    }

    .areas-hero {
      padding: 64px 0 56px;
    }

    .areas-title {
      font-size: 34px;
    }

    .areas-list-section {
      padding: 48px 0 56px;
    }
  }
</style>
