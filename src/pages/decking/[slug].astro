---
import AreaPage from '../../components/pages/AreaPage.astro';
import { areas, getAreaBySlug } from '../../data/areas';

export function getStaticPaths() {
  return areas
    .filter((areaPage) => areaPage.servicePath === 'decking')
    .map((areaPage) => ({
      params: { slug: areaPage.slug },
      props: { areaPage },
    }));
}

const areaPage = Astro.props.areaPage ?? getAreaBySlug(Astro.params.slug ?? '');

if (!areaPage || areaPage.servicePath !== 'decking') {
  throw new Error(`Unknown decking area page: ${Astro.params.slug}`);
}
---

<AreaPage areaPage={areaPage} />
