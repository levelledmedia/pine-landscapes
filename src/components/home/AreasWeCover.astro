---
import EditableText from '../EditableText.astro';
import Badge from '../Badge.astro';
import { business, content } from '../../config/site';

const mapQuery = business.mapQuery || 'London';
const { badgeText, heading, body, towns = [] } = content.home.areasWeCover;
---

<div class="areas-row" style="max-width:var(--container-width);margin:0 auto;padding:100px 40px;display:flex;gap:60px;align-items:stretch;flex-wrap:wrap;">
  <div class="areas-map" style="position:relative;flex:1 1 420px;min-height:400px;border-radius:var(--radius);overflow:hidden;" data-dev-hover-zone={import.meta.env.DEV ? true : undefined}>
    <iframe
      class="areas-map-iframe"
      data-src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`}
      style="width:100%;height:100%;min-height:400px;border:0;display:block;"
      title="Map"
    ></iframe>
    {import.meta.env.DEV && (
      <div class="dev-map-control" data-map-key="business.mapQuery" data-map-value={mapQuery} style="position:absolute;bottom:12px;right:12px;z-index:9999;"></div>
    )}
  </div>
  <div style="flex:1 1 420px;">
    <Badge editKey="home.areasWeCover.badgeText" value={badgeText} tone="dark" />
    <EditableText
      editKey="home.areasWeCover.heading"
      value={heading}
      as="h2"
      style="font-family:var(--font-heading);font-weight:700;font-size:var(--fsH2, 36px);text-transform:var(--heading-case);margin:0 0 16px;color:var(--color-ink);"
    />
    <EditableText
      editKey="home.areasWeCover.body"
      value={body}
      as="div"
      multiline
      style="font-size:var(--fsBody, 17px);line-height:1.7;color:oklch(0.4 0.02 255);margin:0 0 28px;"
    />
    <div style="display:flex;flex-wrap:wrap;gap:10px;">
      {towns.map((town, i) => (
        <EditableText
          editKey={`home.areasWeCover.towns.${i}`}
          value={town}
          as="span"
          style="display:inline-block;padding:9px 18px;border-radius:999px;background:var(--color-offwhite-deep);color:var(--color-primary);font-weight:600;font-size:14px;"
        />
      ))}
    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) {
    .areas-row {
      padding-top: 56px !important;
      padding-bottom: 56px !important;
      padding-left: 20px !important;
      padding-right: 20px !important;
      gap: 32px !important;
    }

    .areas-map,
    .areas-map :global(iframe) {
      min-height: 220px !important;
    }
  }
</style>

<script>
  // Loads the map iframe as soon as it's within ~1000px of the viewport,
  // well before it's scrolled to — native loading="lazy" only starts the
  // fetch once the section is much closer, which is what made the map
  // visibly pop in after arriving rather than already being loaded.
  const mapIframe = document.querySelector<HTMLIFrameElement>('.areas-map-iframe');
  if (mapIframe) {
    const src = mapIframe.dataset.src;
    if (src) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              mapIframe.src = src;
              observer.disconnect();
            }
          }
        },
        { rootMargin: '1000px 0px' }
      );
      observer.observe(mapIframe);
    }
  }
</script>
