---
import ImageSlot from '../ImageSlot.astro';
import EditableText from '../EditableText.astro';
import { content, swaps } from '../../config/site';
import { withBase } from '../../lib/base';
import { pageHref } from '../../lib/pages';

const projects = [{ id: 'proj-1' }, { id: 'proj-2' }, { id: 'proj-3' }];

// 'tall' is the original height; 'short'/'shorter' scale it down ~20%/~40%;
// 'tallest' scales it up ~20%.
const FEATURED_HEIGHT = { tallest: 653, tall: 544, short: 435, shorter: 326 } as const;
const imageHeight = FEATURED_HEIGHT[swaps?.featuredHeight ?? 'tall'];
const barBg = swaps?.featuredProjectsBg === 'primary' ? 'var(--color-primary)' : 'var(--color-accent)';
---

<div id="projects" style="position:relative;" data-dev-hover-zone={import.meta.env.DEV ? true : undefined}>
  <div style={`background:${barBg};display:flex;align-items:center;justify-content:space-between;padding:16px 40px;`}>
    <EditableText
      editKey="home.featuredProjectsLabel"
      value={content.home.featuredProjectsLabel ?? 'Featured Projects'}
      as="h3"
      style="font-family:var(--font-heading);font-weight:700;font-size:18px;text-transform:var(--heading-case);color:#fff;margin:0;"
    />
    <EditableText editKey="home.featuredProjectsCta" value={content.home.featuredProjectsCta} class="btn-outline" href={withBase(pageHref('projects'))} />
  </div>
  <div class="projects-grid" style="display:grid;gap:0;">
    {projects.map((p, i) => (
      <div id={`proj-thumb-${i}`} class="proj-thumb" style={`height:${imageHeight}px;`} draggable="false">
        <ImageSlot id={p.id} shape="rect" style="width:100%;height:100%;" />
        <div class="proj-overlay"></div>
      </div>
    ))}
  </div>
  {import.meta.env.DEV && (
    <div
      class="dev-height-handle"
      data-handle-key="swaps.featuredHeight"
      data-handle-current={swaps?.featuredHeight ?? 'tall'}
      data-handle-stops={JSON.stringify(
        (['shorter', 'short', 'tall', 'tallest'] as const).map((name) => ({
          name,
          save: name,
          effects: [0, 1, 2].map((i) => ({ target: `proj-thumb-${i}`, prop: 'height', value: `${FEATURED_HEIGHT[name]}px` })),
        })),
      )}
      style="position:absolute;bottom:0;left:50%;transform:translate(-50%,50%);z-index:9999;pointer-events:auto;"
    ></div>
  )}
  {import.meta.env.DEV && (
    <div
      class="dev-variant-cycle"
      data-cycle-key="swaps.featuredProjectsBg"
      data-cycle-options="accent,primary"
      data-cycle-icon="droplet"
      data-cycle-current={swaps?.featuredProjectsBg ?? 'accent'}
      data-cycle-title="Toggle bar color"
      style="position:absolute;top:12px;left:12px;z-index:9999;pointer-events:auto;"
    ></div>
  )}
</div>

<style>
  .projects-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 860px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }

    .proj-thumb {
      height: 240px !important;
    }
  }

  .proj-thumb {
    position: relative;
    display: block;
    overflow: hidden;
  }
  .proj-thumb :global(.image-slot-zoom) {
    transition: transform 0.5s ease;
  }
  .proj-thumb:hover :global(.image-slot-zoom) {
    transform: scale(1.06);
  }
  .proj-thumb:hover :global(.image-slot-zoom img) {
    opacity: 0.85;
  }
  .proj-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0) 55%);
    pointer-events: none;
  }
</style>
