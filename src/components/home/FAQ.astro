---
import EditableText from '../EditableText.astro';
import Badge from '../Badge.astro';
import { content, swaps } from '../../config/site';

const { heading, subheading, items, badgeText } = content.home.faq;
const faqStyle = swaps?.faqStyle ?? 'accordion';
const isList = faqStyle === 'list';
// 'minimal' is the same accordion mechanics as 'accordion', just styled with
// a plain bordered bar instead of the heavy primary/accent-colored one.
const isMinimal = faqStyle === 'minimal';
// 'default' matches the original 920px block; 'narrow' tightens it for a
// more focused, single-column reading width.
const FAQ_WIDTH = { default: 920, narrow: 780 } as const;
const faqWidth = swaps?.faqWidth ?? 'default';
---

<div id="faq" style="position:relative;" data-dev-hover-zone={import.meta.env.DEV ? true : undefined}>
  <div class="faq-section" style={`max-width:${FAQ_WIDTH[faqWidth]}px;margin:0 auto;padding:90px 40px;text-align:center;`}>
  <Badge editKey="home.faq.badgeText" value={badgeText ?? 'FAQ'} tone="dark" style="align-items:center;" />
  <EditableText
    editKey="home.faq.heading"
    value={heading}
    as="h2"
    style="font-family:var(--font-heading);font-weight:700;font-size:var(--fsH2, 36px);text-transform:var(--heading-case);margin:0 0 14px;color:var(--color-ink);"
  />
  <EditableText
    editKey="home.faq.subheading"
    value={subheading}
    as="p"
    style="font-size:var(--fsBody, 17px);line-height:1.7;color:oklch(0.4 0.02 255);max-width:560px;margin:0 auto 40px;"
  />
  <div style="text-align:left;" data-faq-list={import.meta.env.DEV ? true : undefined}>
    {isList
      ? (
        <div class="faq-list">
          {items.map((item, i) => (
            <div class="faq-list-item" data-faq-item={i}>
              <EditableText
                editKey={`home.faq.items.${i}.q`}
                value={item.q}
                as="h4"
                style="font-family:var(--font-heading);font-weight:700;font-size:var(--fsH3, 20px);text-transform:var(--heading-case);margin:0 0 10px;color:var(--color-primary);"
              />
              <EditableText
                editKey={`home.faq.items.${i}.a`}
                value={item.a}
                as="div"
                multiline
                style="font-size:var(--fsBody, 18px);line-height:1.7;color:oklch(0.4 0.02 255);"
              />
            </div>
          ))}
        </div>
      )
      : items.map((item, i) => (
          <details class={`faq-item ${isMinimal ? 'minimal' : ''}`} data-faq-item={i} open={i === 0}>
            <summary class="faq-bar">
              <EditableText editKey={`home.faq.items.${i}.q`} value={item.q} as="span" />
            </summary>
            <div class="faq-body">
              <EditableText editKey={`home.faq.items.${i}.a`} value={item.a} as="span" multiline />
            </div>
          </details>
        ))}
  </div>
  </div>
  {import.meta.env.DEV && (
    <div style="position:absolute;top:12px;left:12px;z-index:9999;display:flex;gap:8px;">
      <div
        class="dev-variant-cycle"
        data-cycle-key="swaps.faqStyle"
        data-cycle-options="accordion,minimal,list"
        data-cycle-label="Accordion,Minimal,List"
        data-cycle-current={faqStyle}
        style="pointer-events:auto;"
      ></div>
      <div
        class="dev-variant-cycle"
        data-cycle-key="swaps.faqWidth"
        data-cycle-options="default,narrow"
        data-cycle-icon="widthToggle"
        data-cycle-current={faqWidth}
        data-cycle-title="Toggle width"
        style="pointer-events:auto;"
      ></div>
    </div>
  )}
</div>

<style>
  .faq-item { margin-bottom: 10px; position: relative; }
  .faq-bar {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    padding: 18px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  .faq-bar::-webkit-details-marker { display: none; }
  .faq-bar::after { content: '▼'; font-size: 11px; flex-shrink: 0; }
  .faq-item[open] .faq-bar { background: var(--color-accent); border-radius: var(--radius) var(--radius) 0 0; }
  .faq-item[open] .faq-bar::after { content: '▲'; }

  /* Same accordion mechanics as the default, just with the color pop
     stripped out — a plain bordered bar instead of the solid primary/accent
     background. */
  .faq-item.minimal .faq-bar {
    background: #fff;
    color: var(--color-ink);
    border: 1px solid oklch(0.9 0.006 255);
    border-radius: var(--radius);
  }
  .faq-item.minimal .faq-bar::after {
    color: oklch(0.55 0.02 255);
  }
  .faq-item.minimal[open] .faq-bar {
    background: #fff;
    border-color: oklch(0.85 0.006 255);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .faq-item.minimal .faq-body {
    border: 1px solid oklch(0.9 0.006 255);
    border-top: none;
    box-shadow: none;
  }
  .faq-list-item {
    padding: 24px 0;
    border-top: 1px solid oklch(0.9 0.006 255);
    position: relative;
  }
  .faq-list-item:first-child {
    padding-top: 0;
    border-top: none;
  }
  .faq-body {
    background: #fff;
    padding: 20px 24px;
    font-size: 17px;
    line-height: 1.7;
    color: oklch(0.4 0.02 255);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 1px 0 oklch(0.9 0.006 255) inset;
  }

  @media (max-width: 640px) {
    .faq-section {
      padding-top: 56px !important;
      padding-bottom: 56px !important;
      padding-left: 20px !important;
      padding-right: 20px !important;
    }

    .faq-bar {
      padding: 16px 18px;
      font-size: 16px;
    }
  }
</style>
