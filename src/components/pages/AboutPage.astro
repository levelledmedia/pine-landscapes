---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import Breadcrumb from '../Breadcrumb.astro';
import ImageSlot from '../ImageSlot.astro';
import EditableText from '../EditableText.astro';
import Badge from '../Badge.astro';
import Badges from '../home/Badges.astro';
import SplitFeature from '../home/SplitFeature.astro';
import ContactSection from '../home/ContactSection.astro';
import { content } from '../../config/site';
import { withBase } from '../../lib/base';

const { reasons: reasonsIntro } = content.about;

const reasons = [
  {
    title: 'Built on Honest Work and Experience',
    body: 'Pine Landscapes is owned by Mark and backed by more than 30 years of hands-on landscaping experience. That experience shapes everything from the advice we give at quote stage to the standard of finish we aim for on every job.',
  },
  {
    title: 'A Family-Owned Company Covering Beds and Herts',
    body: 'We are a family-owned business in the Hitchin area and regularly take on work throughout Hertfordshire and Bedfordshire. Whether the job is close to home or a little further out, we approach it with the same care, reliability and pride in the finished result.',
  },
  {
    title: 'A Full Range of Landscaping Services',
    body: 'Our work covers fencing, decking, paving, turfing and wider landscaping improvements, along with the preparation and groundwork needed to complete a project properly. We can take care of one specific element or help bring several parts together as part of a full garden transformation.',
  },
  {
    title: 'Quality Materials and Guaranteed Workmanship',
    body: 'We use quality materials because we want the finished work to last, not just look good on day one. Our workmanship is fully guaranteed, which gives customers added peace of mind that the project has been carried out properly and built to stand up over time.',
  },
  {
    title: 'Practical Advice and Free Competitive Quotes',
    body: 'Not every customer comes to us with a finished plan, and that is fine. We are happy to talk through ideas, materials and layouts, then provide a free competitive quote based on what makes the most sense for your property, your budget and how you want to use the space.',
  },
];
---

<Layout title="About Us | Crestline Landscapes">
  <PageHero imageId="about-hero" title="About Us" />
  <Breadcrumb label="About Us" />

  <SplitFeature
    editKey="home.ourStory"
    imageId="before-after"
    imagePlaceholder="Drop team or project photo"
    heading={content.home.ourStory.heading}
    body={content.home.ourStory.body}
    ctaLabel={content.home.ourStory.cta}
    ctaHref={withBase('/#contact')}
    badgeText={content.home.ourStory.badgeText}
  />

  <div class="about-reasons" style="position:relative;">
    <ImageSlot id="reasons-bg" shape="rect" style="position:absolute;inset:0;width:100%;height:100%;" />
    <div style="position:absolute;inset:0;background:rgba(15,20,35,.75);pointer-events:none;"></div>
    <div style="position:relative;max-width:var(--container-width);margin:0 auto;display:flex;gap:56px;flex-wrap:wrap;">
      <div style="flex:1 1 380px;">
        <Badge editKey="about.reasons.badgeText" value={reasonsIntro.badgeText ?? 'Why Choose Us'} tone="light" />
        <EditableText editKey="about.reasons.heading" value={reasonsIntro.heading} as="h2" style="font-family:var(--font-heading);font-weight:700;font-size:32px;text-transform:var(--heading-case);color:#fff;margin:0 0 16px;" />
        <EditableText
          editKey="about.reasons.body"
          value={reasonsIntro.body}
          as="div"
          multiline
          style="font-size:15px;line-height:1.8;color:rgba(255,255,255,.85);margin:0 0 24px;"
        />
        <EditableText editKey="about.reasons.cta" value={reasonsIntro.cta} class="btn-accent" href={withBase('/#contact')} style="--btn-bg:var(--color-primary);" />
      </div>
      <div style="flex:1 1 480px;" data-accordion-group="about-reasons">
        {reasons.map((r, i) => (
          <details class="reason" open={i === 0}>
            <summary class="reason-bar">{r.title}</summary>
            <div class="reason-body" data-accordion-body>{r.body}</div>
          </details>
        ))}
      </div>
    </div>
  </div>

  <Badges />

  <ContactSection />
</Layout>

<style>
  .about-reasons {
    padding: 90px 40px;
  }
  .reason { margin-bottom: 10px; }
  .reason-bar {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    padding: 18px 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }
  .reason[open] .reason-bar {
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .reason-bar::-webkit-details-marker { display: none; }
  .reason-bar::after { content: '▼'; font-size: 11px; flex-shrink: 0; }
  .reason[open] .reason-bar { background: var(--color-accent); }
  .reason[open] .reason-bar::after { content: '▲'; }
  .reason-body {
    background: #fff;
    padding: 22px 24px;
    font-size: 17px;
    line-height: 1.7;
    color: oklch(0.4 0.02 255);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 1px 0 oklch(0.9 0.006 255) inset;
  }

  @media (max-width: 640px) {
    .about-reasons {
      padding: 56px 20px;
    }

    .reason-bar {
      padding: 16px 18px;
    }
  }
</style>
