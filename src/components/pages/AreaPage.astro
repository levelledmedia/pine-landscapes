---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import ImageSlot from '../ImageSlot.astro';
import ContactSection from '../home/ContactSection.astro';
import { content } from '../../config/site';
import type { AreaPage as AreaPageData } from '../../data/areas';

interface Props {
  areaPage: AreaPageData;
}

const { areaPage } = Astro.props;
const { overlayOpacity = 0.4 } = content.home.hero;
---

<Layout title={`${areaPage.pageTitle} | Pine Landscapes`} description={areaPage.pageDescription}>
  <div class="area-hero" style="position:relative;">
    <ImageSlot id={areaPage.imageId} shape="rect" style="position:absolute;inset:0;width:100%;height:100%;" editable={false} />
    <div style={`position:absolute;inset:0;background:rgba(15,20,35,${overlayOpacity});pointer-events:none;`}></div>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
      <h1 class="area-hero-title">{areaPage.heroTitle}</h1>
    </div>
  </div>

  <Breadcrumb label={areaPage.area} parentLabel="Areas" parentHref="/areas" />

  <section class="area-intro">
    <div class="area-shell area-intro-grid">
      <div>
        <p class="area-kicker">{areaPage.postcodeLabel}</p>
        <h2 class="area-h2" style="margin-top:0;">{areaPage.introHeading}</h2>
        <h3 class="area-h3">{areaPage.introSubheading}</h3>
        {areaPage.introBody.map((paragraph) => (
          <p class="area-p">{paragraph}</p>
        ))}
      </div>
      <ImageSlot id={areaPage.imageId} shape="rect" class="area-intro-image" editable={false} />
    </div>
  </section>

  <section class="area-body">
    <div class="area-shell area-body-grid">
      <div class="area-card">
        <h2 class="area-h2">{areaPage.offeringsHeading}</h2>
        <ul class="area-list">
          {areaPage.offerings.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="area-card">
        <h2 class="area-h2">{areaPage.materialsHeading}</h2>
        <ul class="area-list">
          {areaPage.materials.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="area-about">
    <div class="area-shell">
      <h2 class="area-h2">{areaPage.aboutHeading}</h2>
      {areaPage.aboutBody.map((paragraph) => (
        <p class="area-p">{paragraph}</p>
      ))}
    </div>
  </section>

  <ContactSection />
</Layout>

<style>
  .area-shell {
    max-width: var(--container-width);
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
  }

  .area-hero {
    height: 260px;
  }

  .area-hero-title {
    margin: 0;
    padding: 0 20px;
    color: #fff;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 42px;
    text-transform: var(--heading-case);
  }

  .area-intro {
    background: oklch(0.95 0.006 255);
    padding: 72px 0;
  }

  .area-intro-grid,
  .area-body-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    align-items: start;
  }

  .area-intro-image {
    min-height: 320px;
  }

  .area-body {
    padding: 72px 0;
  }

  .area-about {
    padding: 0 0 80px;
  }

  .area-card {
    background: #fff;
    border: 1px solid oklch(0.9 0.01 255);
    border-radius: var(--radius);
    padding: 28px;
    box-shadow: 0 18px 40px rgba(15, 20, 35, 0.06);
  }

  .area-kicker {
    margin: 0 0 10px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .area-h2 {
    margin: 0 0 14px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 700;
  }

  .area-h3 {
    margin: 0 0 14px;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
  }

  .area-p {
    margin: 0 0 16px;
    color: oklch(0.4 0.02 255);
    font-size: 15px;
    line-height: 1.8;
  }

  .area-list {
    margin: 0;
    padding-left: 20px;
    color: oklch(0.4 0.02 255);
  }

  .area-list li {
    margin-bottom: 10px;
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .area-intro-grid,
    .area-body-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .area-shell {
      padding-left: 20px;
      padding-right: 20px;
    }

    .area-hero {
      height: 220px;
    }

    .area-hero-title {
      font-size: 30px;
    }

    .area-intro,
    .area-body {
      padding: 48px 0;
    }

    .area-about {
      padding-bottom: 56px;
    }

    .area-intro-image {
      min-height: 220px;
    }

    .area-card {
      padding: 22px;
    }
  }
</style>
