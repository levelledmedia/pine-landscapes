---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import ImageSlot from '../ImageSlot.astro';
import ContactSection from '../home/ContactSection.astro';
import { content, gallery, images, swaps } from '../../config/site';
import { withBase } from '../../lib/base';
import { pageHref } from '../../lib/pages';
import type { AreaPage as AreaPageData } from '../../data/areas';

interface Props {
  areaPage: AreaPageData;
}

const { areaPage } = Astro.props;
const { overlayOpacity = 0.4 } = content.home.hero;
const pageHeroTall = swaps?.pageHeroTall ?? 'default';
const galleryPhotos = gallery.filter((g) => g.tag === areaPage.serviceId && images[g.id]?.src);
const workSlots = [0, 1, 2].map((i) => {
  const selectedId = galleryPhotos[i]?.id;
  return { selectedId };
});
---

<Layout title={`${areaPage.pageTitle} | Pine Landscapes`} description={areaPage.pageDescription}>
  <div class={`svc-hero ${pageHeroTall === 'tall' ? 'tall' : ''}`} style="position:relative;">
    <ImageSlot id={areaPage.serviceId} shape="rect" style="position:absolute;inset:0;width:100%;height:100%;" editable={false} />
    <div style={`position:absolute;inset:0;background:rgba(15,20,35,${overlayOpacity});pointer-events:none;`}></div>
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
      <h1 class="svc-hero-title" style="font-family:var(--font-heading);font-weight:700;text-transform:var(--heading-case);color:#fff;margin:0;letter-spacing:.03em;text-align:center;">{areaPage.pageTitle}</h1>
    </div>
  </div>

  <Breadcrumb label={areaPage.area} parentLabel="Areas" parentHref="/areas" />

  <div class="svc-intro" style="background:oklch(0.95 0.006 255);">
    <div style="max-width:var(--container-width);margin:0 auto;display:flex;gap:50px;align-items:center;flex-wrap:wrap;">
      <div style="flex:1 1 400px;">
        <h2 style="font-family:var(--font-heading);font-weight:700;font-size:28px;margin:0 0 16px;color:var(--color-ink);">{areaPage.introHeading}</h2>
        {areaPage.introBody.map((paragraph) => (
          <p class="svc-p">{paragraph}</p>
        ))}
        <a class="btn-accent" href="#contact">Get Free Quote</a>
      </div>
      <ImageSlot id={areaPage.serviceId} shape="rect" class="svc-intro-image" style="flex:1 1 400px;" editable={false} />
    </div>
  </div>

  <div class="svc-body" style="max-width:900px;margin:0 auto;">
    <h2 class="svc-h" style="margin-top:0;">{areaPage.listHeading}</h2>
    <ul class="svc-list">
      {areaPage.listItems.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <h2 class="svc-h">{areaPage.aboutHeading}</h2>
    {areaPage.aboutBody.map((paragraph) => (
      <p class="svc-p">{paragraph}</p>
    ))}
  </div>

  <div class="svc-gallery-section" style="max-width:var(--container-width);margin:0 auto;">
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <h2 style="font-family:var(--font-heading);font-weight:700;font-size:22px;margin:0;color:var(--color-ink);">Examples of Our Work</h2>
      <a class="btn-accent" href={withBase(pageHref('projects'))}>View Projects</a>
    </div>
    <div class="svc-gallery">
      {workSlots.map((slot, i) => (
        slot.selectedId ? (
          <div class="svc-gallery-tile" style="position:relative;">
            <div class="svc-gallery-frame">
              <ImageSlot id={slot.selectedId} shape="rounded" style="width:100%;height:100%;" editable={false} />
            </div>
          </div>
        ) : (
          <div class="svc-gallery-frame">
            <ImageSlot id={`${areaPage.serviceId}-work-${i + 1}`} shape="rounded" style="width:100%;height:100%;" />
          </div>
        )
      ))}
    </div>
  </div>

  <ContactSection />
</Layout>

<style>
  .svc-list { margin: 0 0 20px; padding-left: 20px; }
  .svc-list li { font-size: 15px; line-height: 1.8; color: oklch(0.4 0.02 255); }
  .svc-h { font-family: var(--font-heading); font-weight: 700; font-size: 24px; color: var(--color-ink); margin: 36px 0 12px; }
  .svc-p { font-size: 15px; line-height: 1.8; color: oklch(0.4 0.02 255); margin: 0 0 16px; }

  .svc-hero {
    height: 200px;
  }
  .svc-hero.tall {
    height: 300px;
  }
  .svc-hero-title {
    font-size: 40px;
  }
  .svc-intro {
    padding: 70px 40px;
  }
  .svc-intro-image {
    height: 340px;
    flex: 1 1 400px;
  }
  .svc-body {
    padding: 70px 40px;
  }
  .svc-gallery-section {
    padding: 0 40px 80px;
  }
  .svc-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .svc-gallery-frame {
    height: 200px;
  }

  @media (max-width: 860px) {
    .svc-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .svc-hero {
      height: auto;
      min-height: 220px;
    }
    .svc-hero.tall {
      min-height: 320px;
    }
    .svc-hero-title {
      font-size: 32px;
      padding: 0 20px;
    }
    .svc-intro,
    .svc-body {
      padding-left: 20px;
      padding-right: 20px;
    }
    .svc-intro {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .svc-intro-image {
      height: 220px;
    }
    .svc-body {
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .svc-gallery-section {
      padding-left: 20px;
      padding-right: 20px;
    }
    .svc-gallery {
      grid-template-columns: 1fr;
    }
    .svc-gallery-frame {
      height: 220px;
    }
  }
</style>
