---
// Shared icon row for business.socials — used by both Header.astro (top
// bar) and Footer.astro so the platform list/icons only need to stay in
// sync in one place. Icons sourced from https://icon-sets.iconify.design/
// (Simple Icons set for Facebook/Instagram/X/YouTube — these are simple
// enough to hand-copy accurately per /CLAUDE.md; TikTok/LinkedIn/Pinterest
// render as a plain monogram instead of attempting their more intricate
// brand marks by hand).
type Socials = Partial<Record<'facebook' | 'instagram' | 'whatsapp' | 'x' | 'youtube' | 'linkedin' | 'tiktok' | 'pinterest', string>>;

interface Props {
  socials: Socials;
  email?: string;
  size?: number;
  style?: string;
}

const { socials, email, size = 15, style = '' } = Astro.props;

const PLATFORMS: { id: keyof Socials; label: string; icon: string }[] = [
  {
    id: 'facebook',
    label: 'Facebook',
    icon: '<path d="M22 12.06C22 6.53 17.52 2 12 2S2 6.53 2 12.06c0 5 3.66 9.13 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.81 8.44-4.94 8.44-9.94Z"/>',
  },
  {
    id: 'instagram',
    label: 'Instagram',
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1"/>',
  },
  {
    id: 'whatsapp',
    label: 'WhatsApp',
    icon: '<path fill="currentColor" d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91c0-2.65-1.03-5.14-2.9-7.01m-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18l-3.12.82l.83-3.04l-.2-.31a8.26 8.26 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24c2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23m4.52-6.16c-.25-.12-1.47-.72-1.69-.81c-.23-.08-.39-.12-.56.12c-.17.25-.64.81-.78.97c-.14.17-.29.19-.54.06c-.25-.12-1.05-.39-1.99-1.23c-.74-.66-1.23-1.47-1.38-1.72c-.14-.25-.02-.38.11-.51c.11-.11.25-.29.37-.43s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c-.22.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74c.59.26 1.05.41 1.41.52c.59.19 1.13.16 1.56.1c.48-.07 1.47-.6 1.67-1.18c.21-.58.21-1.07.14-1.18s-.22-.16-.47-.28"/>',
  },
  {
    id: 'x',
    label: 'X',
    icon: '<path d="M4 4l16 16M20 4 4 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  },
  {
    id: 'youtube',
    label: 'YouTube',
    icon: '<rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 9.2 15.5 12 10 14.8V9.2Z"/>',
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    icon: '<circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.3"/><text x="12" y="16" font-size="10" font-weight="700" text-anchor="middle" font-family="Arial, sans-serif">in</text>',
  },
  {
    id: 'tiktok',
    label: 'TikTok',
    icon: '<circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.3"/><text x="12" y="15.5" font-size="8.5" font-weight="700" text-anchor="middle" font-family="Arial, sans-serif">TT</text>',
  },
  {
    id: 'pinterest',
    label: 'Pinterest',
    icon: '<circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.3"/><text x="12" y="16" font-size="10" font-weight="700" text-anchor="middle" font-family="Arial, sans-serif">P</text>',
  },
];
---

{PLATFORMS.map((p) => {
  const url = socials?.[p.id];
  return url ? (
    <a href={url} aria-label={p.label} class="social-icon-link" style={`display:flex;color:inherit;${style}`} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" aria-hidden="true" set:html={p.icon} />
    </a>
  ) : null;
})}
{email && (
  <a href={`mailto:${email}`} aria-label="Email" class="social-icon-link" style={`display:flex;color:inherit;${style}`}>
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"/>
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
    </svg>
  </a>
)}

<style>
  .social-icon-link {
    transition: opacity 0.15s ease;
  }
  .social-icon-link:hover {
    opacity: 0.65;
  }
</style>
