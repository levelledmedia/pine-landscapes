  }

  .main-header.tinted .mobile-nav-phone {
    color: #fff;
  }

  .main-header :global(.mobile-nav-cta) {
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    padding-top: 16px;
    padding-bottom: 16px;
  }

  @media (max-width: 900px) {
    .main-header-inner {
      grid-template-columns: auto auto;
      padding: 14px 20px;
      gap: 16px;
    }

    .main-nav,
    .header-actions-inline {
      display: none;
    }

    .mobile-menu-toggle {
      display: inline-flex;
    }

    .brand-lockup {
      font-size: 18px;
    }
  }

  @media (max-width: 560px) {
    .top-bar {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }

    .top-bar-address {
      display: none;
    }
  }
</style>

<script>
  function initMobileNav(header: HTMLElement) {
    const toggle = header.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const panel = header.querySelector<HTMLElement>('#mobile-nav-panel');
    if (!toggle || !panel) return;

    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('mobile-nav-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(!panel.classList.contains('open'));
    });

    panel.querySelectorAll<HTMLButtonElement>('.mobile-nav-summary').forEach((summary) => {
      summary.addEventListener('click', () => {
        const submenu = summary.nextElementSibling as HTMLElement | null;
        const isOpen = submenu?.classList.toggle('open') ?? false;
        summary.setAttribute('aria-expanded', String(isOpen));
      });
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) setOpen(false);
    });
  }

  document.querySelectorAll<HTMLElement>('.main-header').forEach(initMobileNav);
</script>

<style is:global>
  body.mobile-nav-open {
    overflow: hidden;
  }
</style>
