---
import EditableText from './EditableText.astro';
import SocialIcons from './SocialIcons.astro';
import { business, footerQuickLinks, homeServices, images, swaps } from '../config/site';
import { withBase } from '../lib/base';
import { pageHref, serviceHref } from '../lib/pages';

const brandName = business.name || business.legalName;
// Mirrors whatever service cards exist on the home page — no card, no page.
const services = homeServices.flat().map((s) => ({ label: s.label, href: serviceHref(s.label, (s as { slug?: string }).slug) }));
const logo = images?.logo;
// Only the copyright bar itself swaps tone with the Header background
// setting — the rest of the footer stays on the fixed --color-primary
// background regardless.
const isLightBar = (swaps?.headerBackground ?? 'white') === 'white';
const hasAnySocial = Object.values(business.socials ?? {}).some(Boolean) || !!business.email;
// "Areas" isn't one of the header's nav items, so it has no natural slot in
// footerQuickLinks — it's inserted here, right before Contact, to match the
// order requested for the footer specifically (Home, Services, Our Work,
// About Us, Areas, Contact) without adding a page to the header nav itself.
const contactIndex = footerQuickLinks.findIndex((l) => l.navKey === 'contact');
const areasLink = { label: 'Areas', href: '/areas' };
const quickLinks =
  contactIndex === -1
    ? [...footerQuickLinks, areasLink]
    : [...footerQuickLinks.slice(0, contactIndex), areasLink, ...footerQuickLinks.slice(contactIndex)];
---

<footer style="background:var(--color-primary-dark);color:oklch(0.75 0.02 255);">
  <div class="footer-grid" style="max-width:var(--container-width);margin:0 auto;padding:56px 40px;display:grid;gap:32px;">
    <div>
      <div style="color:#fff;font-family:var(--font-heading);font-weight:700;font-size:22px;margin-bottom:14px;">
        <EditableText editKey="business.name" value={brandName} as="span" global />
        {' '}
        <EditableText editKey="business.nameAccent" value={business.nameAccent} as="span" global style="color:oklch(0.68 0.2 25);" />
      </div>
      <EditableText editKey="business.tagline" value={business.tagline} as="p" global style="font-size:15px;line-height:1.8;margin:0;" />
    </div>
    <div>
      <h4 style="color:#fff;font-family:var(--font-heading);font-weight:600;font-size:16px;margin:0 0 18px;">Quick Links</h4>
      <div style="display:flex;flex-direction:column;gap:12px;font-size:15px;">
        {quickLinks.map((link) => (
          <a href={withBase(link.navKey ? pageHref(link.navKey) : link.href)} style="color:oklch(0.75 0.02 255);">{link.label}</a>
        ))}
      </div>
    </div>
    <div>
      <h4 style="color:#fff;font-family:var(--font-heading);font-weight:600;font-size:16px;margin:0 0 18px;">Services</h4>
      <div style="display:flex;flex-direction:column;gap:12px;font-size:15px;">
        {services.map((link) => (
          <a href={withBase(link.href)} style="color:oklch(0.75 0.02 255);">{link.label}</a>
        ))}
      </div>
    </div>
    <div>
      <h4 style="color:#fff;font-family:var(--font-heading);font-weight:600;font-size:16px;margin:0 0 18px;">Get In Touch</h4>
      <EditableText editKey="business.phone" value={business.phone} as="p" global style="font-size:15px;line-height:1.9;margin:0 0 10px;" />
      <EditableText editKey="business.email" value={business.email} as="p" global style="font-size:15px;line-height:1.9;margin:0 0 10px;" />
      <EditableText editKey="business.address" value={business.address} as="p" global style="font-size:15px;line-height:1.9;margin:0 0 10px;" />
      <EditableText editKey="business.hours" value={business.hours} as="p" global style="font-size:15px;line-height:1.9;margin:0;" />
      {hasAnySocial && (
        <div style="display:flex;align-items:center;gap:12px;margin-top:16px;color:oklch(0.75 0.02 255);">
          <SocialIcons socials={business.socials} email={business.email} size={18} />
        </div>
      )}
    </div>
  </div>
  {/* Three independent zones, not two grouped together — copyright pinned
      to the far left, logo alone centered in the bar, Privacy Policy pinned
      to the far right. All three stay within the contained max-width, only
      the bar's own background/border run full-bleed. */}
  <div style={`background:${isLightBar ? '#fff' : 'rgba(0,0,0,.15)'};border-top:1px solid ${isLightBar ? 'rgba(0,0,0,.08)' : 'rgba(255,255,255,.15)'};color:${isLightBar ? 'var(--color-ink)' : 'inherit'};`}>
    <div class="footer-bottom-bar" style="max-width:var(--container-width);margin:0 auto;padding:20px 40px;align-items:center;gap:12px;font-size:var(--fsSmall, 13px);">
      <span class="footer-bottom-copyright">
        © 2026 <EditableText editKey="business.legalName" value={business.legalName} as="span" global style={isLightBar ? 'color:var(--color-ink);' : ''} />
      </span>
      <span class="footer-bottom-logo">
        {logo?.src && (
          <img src={withBase(logo.src)} alt={brandName} style={`height:${Math.round(24 * (logo.scale ?? 1))}px;display:block;`} />
        )}
      </span>
      <a href={withBase('/privacy-policy')} class="footer-bottom-privacy" style="color:inherit;text-decoration:none;">Privacy Policy</a>
    </div>
  </div>
</footer>

<style>
  .footer-grid {
    grid-template-columns: 1.3fr 1fr 1fr 1.3fr;
  }

  .footer-bottom-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .footer-bottom-copyright {
    justify-self: start;
  }

  .footer-bottom-logo {
    justify-self: center;
  }

  .footer-bottom-privacy {
    justify-self: end;
  }

  @media (max-width: 780px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom-bar {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 14px !important;
      padding: 20px 24px !important;
    }

    .footer-bottom-copyright,
    .footer-bottom-logo,
    .footer-bottom-privacy {
      justify-self: center;
    }

    .footer-bottom-copyright {
      order: 2;
    }

    .footer-bottom-logo {
      order: 1;
    }

    .footer-bottom-privacy {
      order: 3;
    }
  }
</style>
