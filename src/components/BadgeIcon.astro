---
// Generic, non-trademarked badge shell for credential/directory listings
// (Checkatrade, Trustpilot, etc.) — no third-party logos, just initials.
// Neutral gray placeholder until these are swapped for real logos.
interface Props {
  label: string;
  initials: string;
}

const { label, initials } = Astro.props;
---

<div style="width:var(--logo-size, 104px);height:var(--logo-size, 104px);border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;padding:0 6px;">
  <span style="font-family:var(--font-heading);font-weight:700;font-size:22px;color:oklch(0.5 0.01 255);line-height:1;">{initials}</span>
  <span style="font-family:var(--font-body);font-size:9px;color:oklch(0.45 0.02 255);text-transform:uppercase;letter-spacing:.03em;margin-top:6px;text-align:center;padding:0 6px;line-height:1.3;">{label}</span>
</div>
